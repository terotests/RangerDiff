; ============================================================================
; RdBytes.rgr — a growable byte writer, a reader, and the Adler-32 checksum
; ============================================================================
; Every number in the delta formats is an unsigned LEB128 varint (7 bits a
; byte, low bits first) or a zigzag varint for signed values. Lengths and
; offsets stay below 2^30, so `len * 2 + kind` fits a 32-bit int on every
; target.
; ============================================================================

Import "pkg:core/RgU32.rgr"
Import "pkg:core/RgText.rgr"

class RdWriter {
    def buf:buffer (buffer_alloc 256)
    def len:int 0

    Constructor () {
    }

    fn ensure:void (extra:int) {
        def need:int (len + extra)
        def cap:int (buffer_length buf)
        if (need <= cap) {
            return
        }
        def ncap:int (cap * 2)
        while (ncap < need) {
            ncap = (ncap * 2)
        }
        def nb:buffer (buffer_alloc ncap)
        if (len > 0) {
            (buffer_copy nb 0 buf 0 len)
        }
        buf = nb
    }

    fn byte:void (b:int) {
        this.ensure(1)
        (buffer_set buf len b)
        len = (len + 1)
    }

    fn bytes:void (src:buffer off:int n:int) {
        if (n <= 0) {
            return
        }
        this.ensure(n)
        (buffer_copy buf len src off n)
        len = (len + n)
    }

    fn all:void (src:buffer) {
        this.bytes(src 0 (buffer_length src))
    }

    fn varint:void (value:int) {
        def v:int value
        while (v >= 128) {
            this.byte(((v % 128) + 128))
            v = (idiv v 128)
        }
        this.byte(v)
    }

    fn zigzag:void (v:int) {
        if (v < 0) {
            this.varint((((0 - v) * 2) - 1))
        } {
            this.varint((v * 2))
        }
    }

    ; a 32-bit pattern, big-endian
    fn u32:void (v:int) {
        this.byte((RgU32.byteAt(v 0)))
        this.byte((RgU32.byteAt(v 1)))
        this.byte((RgU32.byteAt(v 2)))
        this.byte((RgU32.byteAt(v 3)))
    }

    ; a 32-bit pattern, little-endian (ZIP)
    fn u32le:void (v:int) {
        this.byte((RgU32.byteAt(v 3)))
        this.byte((RgU32.byteAt(v 2)))
        this.byte((RgU32.byteAt(v 1)))
        this.byte((RgU32.byteAt(v 0)))
    }

    fn u16le:void (v:int) {
        this.byte((bit_and v 255))
        this.byte((bit_and (bit_shr v 8) 255))
    }

    ; UTF-8 bytes of a string, its length first
    fn text:void (s:string) {
        def b:buffer (RdBytes.fromText(s))
        this.varint((buffer_length b))
        this.all(b)
    }

    fn toBuffer:buffer () {
        return (buffer_slice buf 0 len)
    }
}

class RdReader {
    def data:buffer (buffer_alloc 0)
    def pos:int 0
    def len:int 0
    def failed:boolean false

    Constructor (b:buffer) {
        data = b
        len = (buffer_length b)
    }

    fn eof:boolean () {
        return (pos >= len)
    }

    fn byte:int () {
        if (pos >= len) {
            failed = true
            return 0
        }
        def v:int (buffer_get data pos)
        pos = (pos + 1)
        return v
    }

    fn varint:int () {
        def result:int 0
        def mul:int 1
        def guard:int 0
        while true {
            def b:int this.byte()
            result = (result + ((b % 128) * mul))
            if (b < 128) {
                break
            }
            mul = (mul * 128)
            guard = (guard + 1)
            if (guard > 4) {
                failed = true
                break
            }
        }
        return result
    }

    fn zigzag:int () {
        def v:int this.varint()
        if ((v % 2) == 1) {
            return (0 - (idiv (v + 1) 2))
        }
        return (idiv v 2)
    }

    fn u32:int () {
        def b0:int this.byte()
        def b1:int this.byte()
        def b2:int this.byte()
        def b3:int this.byte()
        return (RgU32.fromBytesBE(b0 b1 b2 b3))
    }

    fn bytes:buffer (n:int) {
        if ((n < 0) || ((pos + n) > len)) {
            failed = true
            return (buffer_alloc 0)
        }
        def out:buffer (buffer_slice data pos (pos + n))
        pos = (pos + n)
        return out
    }

    fn text:string () {
        def n:int this.varint()
        def b:buffer this.bytes(n)
        return (RdBytes.toText(b))
    }
}

class RdBytes {

    ; Adler-32 (RFC 1950) as a 32-bit pattern
    static sfn adler32:int (b:buffer) {
        return (RdBytes.adler32Range(b 0 (buffer_length b)))
    }

    static sfn adler32Range:int (b:buffer start:int end:int) {
        def a:int 1
        def s:int 0
        def i:int start
        while (i < end) {
            ; 5552 bytes keep both sums below 2^31 between reductions
            def stop:int (i + 5552)
            if (stop > end) {
                stop = end
            }
            while (i < stop) {
                a = (a + (buffer_get b i))
                s = (s + a)
                i = (i + 1)
            }
            a = (a % 65521)
            s = (s % 65521)
        }
        return (RgU32.fromHalves(s a))
    }

    static sfn equal:boolean (a:buffer b:buffer) {
        def n:int (buffer_length a)
        if (n != (buffer_length b)) {
            return false
        }
        def i:int 0
        while (i < n) {
            if ((buffer_get a i) != (buffer_get b i)) {
                return false
            }
            i = (i + 1)
        }
        return true
    }

    static sfn concat:buffer (a:buffer b:buffer) {
        def na:int (buffer_length a)
        def nb:int (buffer_length b)
        def out:buffer (buffer_alloc (na + nb))
        if (na > 0) {
            (buffer_copy out 0 a 0 na)
        }
        if (nb > 0) {
            (buffer_copy out na b 0 nb)
        }
        return out
    }

    ; UTF-8 encoding of a string (on every target, whatever its own strings are)
    static sfn fromText:buffer (s:string) {
        def cps:[int] (RgText.toCodePoints(s))
        def w (new RdWriter())
        for cps cp:int i {
            if (cp < 128) {
                w.byte(cp)
            } {
                if (cp < 2048) {
                    w.byte((192 + (idiv cp 64)))
                    w.byte((128 + (cp % 64)))
                } {
                    if (cp < 65536) {
                        w.byte((224 + (idiv cp 4096)))
                        w.byte((128 + ((idiv cp 64) % 64)))
                        w.byte((128 + (cp % 64)))
                    } {
                        w.byte((240 + (idiv cp 262144)))
                        w.byte((128 + ((idiv cp 4096) % 64)))
                        w.byte((128 + ((idiv cp 64) % 64)))
                        w.byte((128 + (cp % 64)))
                    }
                }
            }
        }
        return w.toBuffer()
    }

    ; UTF-8 bytes to a string; a broken sequence becomes U+FFFD
    static sfn toText:string (b:buffer) {
        def n:int (buffer_length b)
        def cps:[int]
        def i:int 0
        while (i < n) {
            def c:int (buffer_get b i)
            def need:int 0
            def cp:int c
            if (c >= 240) {
                need = 3
                cp = (c - 240)
            } {
                if (c >= 224) {
                    need = 2
                    cp = (c - 224)
                } {
                    if (c >= 192) {
                        need = 1
                        cp = (c - 192)
                    } {
                        if (c >= 128) {
                            cp = 65533
                        }
                    }
                }
            }
            i = (i + 1)
            def k:int 0
            while (k < need) {
                if (i >= n) {
                    cp = 65533
                    break
                }
                def d:int (buffer_get b i)
                if ((d < 128) || (d >= 192)) {
                    cp = 65533
                    break
                }
                cp = ((cp * 64) + (d - 128))
                i = (i + 1)
                k = (k + 1)
            }
            push cps cp
        }
        return (RgText.fromCodePoints(cps))
    }

    static sfn hex:string (b:buffer) {
        def digits:string "0123456789abcdef"
        def out:string ""
        def n:int (buffer_length b)
        def i:int 0
        while (i < n) {
            def v:int (buffer_get b i)
            out = (out + (substring digits (idiv v 16) ((idiv v 16) + 1)))
            out = (out + (substring digits (v % 16) ((v % 16) + 1)))
            i = (i + 1)
        }
        return out
    }
}
